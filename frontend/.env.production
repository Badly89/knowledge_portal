# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Frontend API Configuration (для клиентской части)
REACT_APP_API_URL=http://10.87.0.53:89  # или конкретный IP для продакшена
REACT_APP_API_VERSION=v1
REACT_APP_ENABLE_ANALYTICS=true
#REACT_APP_SENTRY_DSN=your-sentry-dsn-if-needed

# Security
#REACT_APP_HTTPS_ONLY=true
#REACT_APP_CONTENT_SECURITY_POLICY=true

# Performance
REACT_APP_ENABLE_PRECONNECT=true
REACT_APP_ENABLE_PREFETCH=true
REACT_APP_CACHE_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_SSR=false  # если используете SSR
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE_MODE=true